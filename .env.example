# AI features (server-side only; never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# Shared database + staff PIN (server-side only; never prefix with NEXT_PUBLIC_)
# Leave these empty to run in localStorage demo mode.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Required in production: staff PIN checked on the server. Use a long value. There is no default PIN in production.
ADMIN_PIN=
